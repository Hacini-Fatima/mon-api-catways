{
    "source": {
        "include": ["routes", "services", "models", "middlewares", "app.js"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
        "destination": "./docs-jsdoc/",
        "recurse": true,
        "readme": "README.md"
    },
    "plugins": ["plugins/markdown"]
}
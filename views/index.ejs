<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header>
        <h1>Port de Plaisance Russell</h1>
        <p>API de gestion des réservations de catways</p>
    </header>

        <main>
        <!-- Présentation de l'application -->
        <section>
            <h2>Bienvenue à la Capitainerie</h2>
            <p>
                Le Port de Plaisance Russell vous souhaite la bienvenue. 
                Cet espace sécurisé est réservé à la capitainerie pour la gestion des réservations 
                de catways (appontements pour l'amarrage des bateaux). 
                Connectez-vous pour accéder à votre tableau de bord et gérer les pontons.
            </p>
        </section>

        <hr>

        <!-- Formulaire de connexion -->
        <section id="login">
            <h2>Connexion</h2>
            <form id="loginForm">
                <label for="email">Adresse e-mail :</label>
                <input type="email" id="email" name="email" required placeholder="admin@port-russell.fr">

                <label for="password">Mot de passe :</label>
                <input type="password" id="password" name="password" required placeholder="Votre mot de passe">

                <button type="submit">Se connecter</button>
            </form>
            <p id="loginMessage"></p>
        </section>

        <hr>

        <!-- Lien vers la documentation -->
        <section id="doc">
            <p>
                <a href="/documentation" target="_blank">Documentation</a>
            </p>
        </section>
    </main>

    <script src="/javascripts/main.js"></script>
</body>
</html>